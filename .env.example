# ---------------------------------------------------------------------------
# AI Meeting Platform - environment configuration
#
# Run `npm run setup` after copying this file to `.env` (the setup script does
# it for you). The script generates backend/.env, frontend/.env.local and
# transcription/.env from this single source of truth and fills in random
# secrets. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Backend server ---------------------------------------------------------
PORT=5000
HOST=127.0.0.1
NODE_ENV=development

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- MongoDB ----------------------------------------------------------------
# Metadata only. Audio/video blobs are never stored in MongoDB.
MONGO_URI=mongodb://127.0.0.1:27017/ai-meeting

# --- Authentication ---------------------------------------------------------
# Generated automatically by `npm run setup`.
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=7d
GUEST_TOKEN_EXPIRES_IN=12h

# --- Frontend (public, non-secret) -----------------------------------------
# Leave these EMPTY (recommended). An empty value means "automatic":
#   - opened directly on http://localhost:3000 -> backend on port 5000
#   - opened through the gateway / HTTPS tunnel / LAN -> same origin (/api, /ws)
# Same-origin is what keeps cookies first-party and device capture working
# through one https:// tunnel URL. Set an explicit URL only when the API is
# deliberately hosted on a different origin.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
# STUN only. Without a TURN server some restrictive networks cannot connect.
NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"}]

# --- Remote access (optional) ----------------------------------------------
# `npm run gateway` proxies /api + /ws to the backend and everything else to
# the frontend, so one HTTPS tunnel URL serves the whole app.
GATEWAY_PORT=4000
# Loopback by default: only the tunnel can reach it. Set 0.0.0.0 for plain
# LAN access (chat/viewing only; camera/mic need HTTPS).
GATEWAY_HOST=127.0.0.1

# --- Local transcription service (faster-whisper, port 8000) --------------
TRANSCRIPTION_URL=http://127.0.0.1:8000
TRANSCRIPTION_WS_URL=ws://127.0.0.1:8000
# Shared token required by every transcription request. Generated by setup.
TRANSCRIPTION_TOKEN=replace-with-a-random-local-token
TRANSCRIPTION_PROVIDER=faster-whisper
# large-v3-turbo: multilingual, near-large-v3 accuracy, fast enough for live
# captions on a local GPU. Without CUDA the service falls back to WHISPER_CPU_MODEL.
WHISPER_MODEL=large-v3-turbo
WHISPER_CPU_MODEL=small
# auto | cuda | cpu
WHISPER_DEVICE=auto
# auto -> int8_float16 on CUDA, int8 on CPU
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=auto
# Live caption window: 4s window, 1.5s stride => ~2s caption latency.
WHISPER_CHUNK_SECONDS=4
WHISPER_STRIDE_SECONDS=1.5
# Provisional (in-progress) transcript updates. Set to 0 to disable.
WHISPER_PROVISIONAL_INTERVAL=0.75
# Beam search width. 2 improves accuracy; 1 is fastest.
WHISPER_BEAM_SIZE=2
WHISPER_MODEL_DIR=
WHISPER_CONCURRENCY=2
WHISPER_PRELOAD=1

# --- Local AI (Ollama) ------------------------------------------------------
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
# 3B fits in 6 GB VRAM alongside the Whisper GPU model.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=240000
OLLAMA_NUM_CTX=8192

# --- Summaries --------------------------------------------------------------
# Finalize an incremental summary after this many new finalized segments.
SUMMARY_INCREMENT_SEGMENTS=12
SUMMARY_INCREMENT_MIN_MS=180000
# Transcript characters per map-stage chunk for long meetings.
SUMMARY_CHUNK_CHARS=7000

# --- Limits -----------------------------------------------------------------
MAX_PARTICIPANTS=6
MAX_UPLOAD_MB=25
