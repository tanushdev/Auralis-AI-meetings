# ---------------------------------------------------------------------------
# AI Meeting Platform - environment configuration
#
# Run `npm run setup` after copying this file to `.env` (the setup script does
# it for you). The script generates backend/.env, frontend/.env.local and
# transcription/.env from this single source of truth and fills in random
# secrets. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Backend server ---------------------------------------------------------
PORT=5000
HOST=127.0.0.1
NODE_ENV=development

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- MongoDB ----------------------------------------------------------------
# Metadata only. Audio/video blobs are never stored in MongoDB.
MONGO_URI=mongodb://127.0.0.1:27017/ai-meeting

# --- Authentication ---------------------------------------------------------
# Generated automatically by `npm run setup`.
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=7d
GUEST_TOKEN_EXPIRES_IN=12h

# --- Frontend (public, non-secret) -----------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_WS_URL=ws://localhost:5000
# STUN only. Without a TURN server some restrictive networks cannot connect.
NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"}]

# --- Local transcription service (faster-whisper, port 8000) --------------
TRANSCRIPTION_URL=http://127.0.0.1:8000
TRANSCRIPTION_WS_URL=ws://127.0.0.1:8000
# Shared token required by every transcription request. Generated by setup.
TRANSCRIPTION_TOKEN=replace-with-a-random-local-token
TRANSCRIPTION_PROVIDER=faster-whisper
WHISPER_MODEL=small
# auto | cuda | cpu
WHISPER_DEVICE=auto
# auto -> int8_float16 on CUDA, int8 on CPU
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=auto
# Streaming window: 6s window, 4s stride => 2s of overlap context.
WHISPER_CHUNK_SECONDS=6
WHISPER_STRIDE_SECONDS=4
# Provisional (in-progress) transcript updates. Set to 0 to disable.
WHISPER_PROVISIONAL_INTERVAL=2.5
WHISPER_MODEL_DIR=
WHISPER_CONCURRENCY=2
WHISPER_PRELOAD=1

# --- Local AI (Ollama) ------------------------------------------------------
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_MS=240000
OLLAMA_NUM_CTX=8192

# --- Summaries --------------------------------------------------------------
# Finalize an incremental summary after this many new finalized segments.
SUMMARY_INCREMENT_SEGMENTS=12
SUMMARY_INCREMENT_MIN_MS=180000
# Transcript characters per map-stage chunk for long meetings.
SUMMARY_CHUNK_CHARS=7000

# --- Limits -----------------------------------------------------------------
MAX_PARTICIPANTS=6
MAX_UPLOAD_MB=25
